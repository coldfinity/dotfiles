# mako — notification daemon for the Hyprland session.
# Started by `exec-once = mako` in hyprland.conf.
#
# Before this, nothing on the machine implemented org.freedesktop.Notifications
# at all: notify-send failed with ServiceUnknown and every desktop notification
# — Discord, Spotify, herdr's agent-finished alerts — was silently discarded.
#
# Rosé Pine, matching waybar/.config/waybar/style.css and wezterm:
#
#   TEXT #e0def4   SUBTLE #908caa   IRIS #c4a7e7   LOVE #eb6f92
#   BASE #191724 — the fill
#
# Colour follows the same rule as the bar: it encodes urgency, and the
# resting state is uncoloured.

font=JetBrainsMono Nerd Font 11

# Same fill and hairline edge as the bar's pills. Slightly more opaque:
# waybar sits on a blurred layer, and mako has no equivalent, so the alpha
# has to carry legibility on its own over an arbitrary wallpaper.
background-color=#191724f0
text-color=#e0def4
border-color=#e0def421
progress-color=over #c4a7e73d

border-size=1
border-radius=12
padding=12
margin=8
max-icon-size=48

# Top-right, clearing the bar. waybar occupies y=6..40 (6px margin + 34px
# height), so 46 leaves a 6px gap below it — the same gap the bar's own
# pills use between themselves.
anchor=top-right
margin=46,16,0,0
width=380
height=160

default-timeout=6000
ignore-timeout=0
max-visible=5
layer=overlay

# Urgency. Normal notifications stay uncoloured, matching the bar's rule
# that nothing wears colour at rest.
[urgency=low]
text-color=#908caa
default-timeout=4000

[urgency=normal]
text-color=#e0def4

# Critical notifications never auto-dismiss — that is what critical means.
[urgency=critical]
border-color=#eb6f92
text-color=#e0def4
default-timeout=0
