// Waybar — Linux counterpart to sketchybar/.config/sketchybar/sketchybarrc
//
// A floating, blurred-glass bar. Closer in spirit to sketchybar than a flush
// top bar, but one continuous surface rather than sketchybar's separate
// per-module islands. Left = workspaces + focused app, centre = clock,
// right = system stats / volume / power.
//
// Differences from the macOS bar, forced by the platform:
//   - no battery pill (this machine is a desktop, no /sys/class/power_supply)
//   - GPU comes from nvidia-smi rather than macOS ioreg
//   - no real backdrop blur; sketchybar's frosted glass becomes tinted glass
{
    "layer": "top",
    "position": "top",

    // A single floating bar: inset from all three edges so it reads as a
    // detached surface, but one continuous bar rather than separate islands.
    // The bar's own background is what you see; the module groups inside it
    // are transparent.
    //
    // The real translucency comes from Hyprland, not from here — see the
    // `layerrule = blur, waybar` line in hypr/.config/hypr/hyprland.conf.
    // Without it the alpha below just greys out whatever is behind.
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    // Three pills, not one per module: everything on a side shares a single
    // island, with CSS dividers marking the clusters inside it. Modules are
    // wrapped in groups purely so there is one widget per side to draw the
    // pill on — waybar has no way to draw a background behind a bare list.
    //
    // The clock sits centre, macOS-menu-bar style, rather than in the right
    // cluster where sketchybar had it. Note waybar centres this group against
    // the bar, not against the gap between left and right — so it stays put
    // as the focused-app title changes width.
    "modules-left": ["group/left"],
    "modules-center": ["clock"],
    "modules-right": ["wlr/taskbar", "group/stats", "group/status", "custom/power"],

    "group/left": {
        "orientation": "horizontal",
        "modules": ["hyprland/workspaces", "hyprland/window"]
    },

    // The right side is three pills plus the taskbar: stats | status | power.
    // custom/power needs no group — a single module can carry its own pill,
    // since the background is drawn on the module's own widget.
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "custom/gpu"]
    },

    // Renamed from group/radios now that volume lives here too — the two
    // radios and the sink are all "current state of a device".
    "group/status": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth", "wireplumber"]
    },

    "hyprland/workspaces": {
        // CJK numerals instead of digits. format-icons is keyed by workspace
        // name, which is the number as a string for these numeric workspaces.
        //
        // JetBrainsMono has no CJK coverage, so these resolve through
        // fontconfig fallback to Noto Sans CJK. They are full-width glyphs
        // and so render wider than the digits they replace — the button
        // min-width in style.css is sized for them.
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "default": "{name}"
        },
        // Mirrors the workspace→monitor pinning in hyprland.conf, so each
        // bar only ever lists the workspaces that live on its own output.
        "persistent-workspaces": {
            "DP-1": [1, 2, 3, 4, 5],
            "DP-3": [6, 7, 8, 9]
        }
    },

    // sketchybar's front_app pill.
    "hyprland/window": {
        "format": "{class}",
        "max-length": 40,
        "separate-outputs": true,
        // sketchybar's front_app drew an app icon; waybar can too, resolved
        // from the .desktop entry via the GTK icon theme.
        "icon": true,
        "icon-size": 18,
        // Wayland app-ids are reverse-DNS, so the raw class reads
        // "com.mitchellh.ghostty". Map the ones you use to display names.
        // Keys are regexes matched against the whole formatted string.
        "rewrite": {
            "com.mitchellh.ghostty": "Ghostty",
            "org.wezfurlong.wezterm": "WezTerm",
            "zen": "Zen",
            "discord": "Discord",
            "Spotify": "Spotify",
            "org.mozilla.firefox": "Firefox",
            "code": "VS Code",
            "org.gnome.Nautilus": "Files"
        }
    },

    // Open windows as icons, in their own pill. Backed by the
    // wlr-foreign-toplevel-management protocol, which Hyprland implements —
    // this is not the same source as hyprland/window, so it lists every
    // toplevel rather than just the focused one.
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        // Per-output, matching the workspace pinning: the Gigabyte's bar
        // lists its own windows and the Dell's lists its own.
        "all-outputs": false,
        "tooltip-format": "{title}",
        "on-click": "activate",
        // Middle-click closes. Deliberately not on left-click, which is far
        // too easy to hit by accident on a row of small icons.
        "on-click-middle": "close",
        // Icons are resolved from .desktop entries; anything without one
        // falls back to a generic icon rather than disappearing.
        "ignore-list": []
    },

    // states drive the .warning / .critical CSS classes, so the stat turns
    // amber then red under load instead of being a colour that never moves.
    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%",
        "states": { "warning": 70, "critical": 90 }
    },

    "memory": {
        "interval": 5,
        "format": "RAM {percentage}%",
        "states": { "warning": 75, "critical": 90 }
    },

    // Emits JSON so it can carry a `class`, giving GPU the same
    // warning/critical thresholds cpu and memory get from `states`.
    // A plain-text custom module has no way to signal state.
    "custom/gpu": {
        "interval": 5,
        "return-type": "json",
        "exec": "u=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo 0); if [ \"$u\" -ge 90 ]; then c=critical; elif [ \"$u\" -ge 70 ]; then c=warning; else c=\"\"; fi; printf '{\"text\":\"GPU %s%%\",\"class\":\"%s\"}\\n' \"$u\" \"$c\"",
        "format": "{}"
    },

    // This machine is on wifi (wlp0s20f3); the ethernet port enp6s0 is down.
    // Both formats are defined anyway so the bar is correct if that changes.
    // Glyphs are \uf1eb U+F1EB (wifi) and 󰈀 U+F0200 (ethernet), both verified
    // present in JetBrainsMono Nerd Font.
    "network": {
        "interval": 5,
        "format-wifi": "\uf1eb  {signalStrength}%",
        "format-ethernet": "󰈀  wired",
        "format-linked": "󰈀  no IP",
        "format-disconnected": "\uf1eb  off",
        "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        // nmtui rather than a GUI: no NetworkManager applet is installed,
        // and nmtui is part of the same package as nmcli.
        "on-click": "wezterm start -- nmtui"
    },

    // Icon only when nothing is connected, device name when something is.
    // The bar has no room for "{controller_alias} {status}".
    "bluetooth": {
        "format": "\uf293",
        "format-connected": "\uf293  {device_alias}",
        "format-disabled": "\uf294",
        "format-off": "\uf294",
        "tooltip-format": "{controller_alias}\n{status}",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "wireplumber": {
        "format": "VOL {volume}%",
        "format-muted": "VOL --",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // Power button — opens power-menu.sh (lock / sleep / log out / restart /
    // shut down). Nerd Font power glyph U+F011.
    "custom/power": {
        "format": "",
        "on-click": "~/.config/waybar/power-menu.sh",
        "tooltip": false
    },

    // Chinese, matching the CJK workspace numerals. zh_CN.utf8 is already
    // generated on this box, so no locale-gen is needed.
    //
    // 24-hour on purpose. glibc's zh_CN renders %p as a literal "PM", not
    // 上午/下午, so a 12-hour format would leave an English fragment sitting
    // in an otherwise Chinese string.
    //
    // The L flag is load-bearing: waybar formats through libfmt's chrono
    // support, which only consults `locale` when the spec asks for it. With
    // the locale set but no L, %A still renders as English.
    //
    // Likewise %m/%d rather than %-m/%-d: libfmt has no glibc-style `-`
    // no-padding flag, and using it makes the whole format throw, leaving
    // the module blank.
    //
    // %A is the full weekday (星期二); %a would give the bare 二.
    // Month precedes day: Chinese orders date parts largest-to-smallest,
    // so 08月04日 is the conventional form.
    //
    // Diverges from sketchybar's calendar.sh (%a %d %b %I:%M %p), which
    // stays English on the Mac.
    "clock": {
        "interval": 1,
        "locale": "zh_CN.utf8",
        "format": "{:L%A %m月%d日 %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}
