#!/bin/bash
#
# Sketchybar — matching the quickshell bar on the Linux box.
#
# FLUSH AND FRAMELESS.
#
# The previous revision of this config was three floating, bordered, rounded
# frames over a transparent bar, with hover popups hiding most of the
# readings. This is the opposite of that on every axis: one full-width bar
# flush to the top edge, no frames, no borders, no dividers, and every
# reading visible at rest.
#
# The only decorated thing on the whole bar is the focused workspace, which
# wears an outlined box. That is deliberate — with nothing else boxed, the
# outline alone is enough to carry focus.
#
# Left = workspaces. Centre = clock, and now playing when there is any.
# Right = stats, then device state, then input, battery and power.
#
# Differences from the Linux bar, forced by the platform:
#   - battery exists here; the Linux box is a desktop with no power supply
#   - GPU comes from ioreg's IOAccelerator rather than nvidia-smi
#   - wifi signal is cached from a 4-second system_profiler call rather than
#     read live; see plugins/network.sh
#   - the input-source indicator reads HIToolbox rather than fcitx5-remote
#   - the power button opens a sketchybar popup rather than a rofi menu

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/settings.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar #####
# margin=0 y_offset=0 is what makes it flush and full-width — the floating
# look came entirely from those two. The tint lives here now rather than on
# per-bracket backgrounds, because there are no brackets.
#
# blur_radius stays 0. It is a property of the BAR, so it would blur the
# whole strip; that was wrong for the framed design because it filled the
# gaps between frames, and here it simply isn't the look being copied — the
# reference is a flat tint, not frosted glass.
#
# topmost stays OFF. It was briefly turned on to try to cover the violet dot
# near the right edge; that dot is macOS's screen-recording privacy
# indicator, which the WindowServer draws above every application window, so
# no bar setting can hide it. See the note at the bottom of this file.
# topmost=on also puts the bar over fullscreen windows, which is a real cost
# for no benefit.
sketchybar --bar position=top height=$BAR_HEIGHT margin=0 y_offset=0 \
  padding_left=$BAR_EDGE_PADDING padding_right=$BAR_EDGE_PADDING topmost=off \
  blur_radius=0 sticky=on color=$BAR_COLOR

##### Defaults #####
# Text shadows on everything. With no frames, items sit almost directly on
# the wallpaper, so each glyph needs its own ground — this is what lets
# BAR_COLOR stay as low as it does. distance=0 keeps it a tight halo rather
# than an offset drop shadow, which at 13px just looks blurry.
default=(
  padding_left=0
  padding_right=0
  icon.font="$FONT_MAIN"
  label.font="$FONT_MAIN"
  icon.color=$GREY
  label.color=$TEXT
  icon.shadow.drawing=on
  icon.shadow.color=$TEXT_SHADOW
  icon.shadow.distance=0
  label.shadow.drawing=on
  label.shadow.color=$TEXT_SHADOW
  label.shadow.distance=0
  background.drawing=off
  background.corner_radius=4
  background.height=28
)
sketchybar --default "${default[@]}"

##### Popup style — the power menu is the only one left #####
# Matched to the bar, minus the transparency: a popup sits over arbitrary
# window content rather than over the wallpaper, so alpha here would just
# make it hard to read.
popup=(
  popup.background.color=0xf2191724
  popup.background.border_color=0x2ee0def4
  popup.background.border_width=1
  popup.background.corner_radius=4
  popup.background.shadow.drawing=on
  popup.align=right
  popup.y_offset=2
  popup.height=26
)

##### Left — workspaces #####
# No taskbar. The reference shows workspace numerals alone on the left, so
# the window-icon strip that used to sit beside them is gone along with the
# frame it lived in.
source "$ITEM_DIR/workspaces.sh"

##### Centre — clock, and now playing when there is any #####
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/media.sh"

##### Right #####
# Items placed `right` are laid out right-to-left in the order they are
# added, so this list is the reverse of how it reads on screen: power ends up
# at the right edge and the stats at the left.
source "$ITEM_DIR/power.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/input_source.sh"
source "$ITEM_DIR/status.sh"
source "$ITEM_DIR/stats.sh"

##### Force every script to run once #####
sketchybar --update

##### The violet dot near the right edge #####
#
# NOT DRAWN BY THIS CONFIG, and not removable from here.
#
# It is macOS's screen-recording privacy indicator: a solid ~7pt #6664f9
# circle the WindowServer paints above every application window whenever an
# app holds an active ScreenCaptureKit stream. Nothing sketchybar can set
# will cover it — topmost=on was tried and made no difference, because the
# indicator is drawn above the topmost window level too.
#
# It appears over this bar rather than beside it only because the bar is
# flush to the top edge; the indicator lives in the menu bar strip, which is
# the same rows the bar now occupies.
#
# To remove it, take Screen Recording away from whatever is capturing:
#   System Settings -> Privacy & Security -> Screen & System Audio Recording
# AltTab is the usual culprit on this machine — it captures continuously to
# render window thumbnails. Turning it off there costs the thumbnails and
# nothing else.
