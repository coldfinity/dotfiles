#!/bin/bash
# Floating module panels. Keep center empty for the camera notch.
# Avoid notch sizing properties: this build previously produced tall input windows.

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/settings.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

sketchybar --bar position=top height=$BAR_HEIGHT margin=$BAR_MARGIN y_offset=$BAR_MARGIN \
  corner_radius=$BAR_RADIUS border_width=0 border_color=$SURFACE_BORDER \
  padding_left=$BAR_EDGE_PADDING padding_right=$BAR_EDGE_PADDING topmost=off \
  blur_radius=0 sticky=on color=$BAR_COLOR

default=(
  padding_left=0
  padding_right=0
  icon.font="$FONT_ICON"
  label.font="$FONT_TEXT"
  icon.color=$GREY
  label.color=$TEXT
  background.corner_radius=6
  background.height=24
  background.drawing=off
)
sketchybar --default "${default[@]}"

# Dedicated spacers stay outside bracket backgrounds.
add_gap() {
  sketchybar --add item "gap.$1" "$2" --set "gap.$1" width=8 \
    icon.drawing=off label.drawing=off background.drawing=off
}

source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/workspaces.sh"
add_gap application left
source "$ITEM_DIR/window_title.sh"

source "$ITEM_DIR/clock.sh"
add_gap clock right
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/input_source.sh"
source "$ITEM_DIR/audio.sh"
source "$ITEM_DIR/network.sh"
add_gap controls right
source "$ITEM_DIR/stats.sh"
source "$ITEM_DIR/media.sh"

source "$ITEM_DIR/theme.sh"

sketchybar --update
