# Theme
theme = Rose Pine
# theme = Black Metal
# theme = Black Metal (Venom)

command = zsh

# Font
font-family = Iosevka Nerd Font
font-size = 18
font-thicken = false

adjust-cell-height = 20%

# Cursor
cursor-style = block
cursor-style-blink = true

# Tabs
window-padding-x = 10
window-padding-y = 10

# Window
background-opacity = 0.8
background-blur-radius = 40

# Scrollback
scrollback-limit = 10000

# Initial size
window-height = 50
window-width = 200
