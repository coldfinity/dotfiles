#!/usr/bin/env bash
languages=`echo "python lua cpp c typescript nodejs r" | tr ' ' '\n'`
core_utils=`echo "xargs find mv sed awk git grep curl" | tr ' ' '\n'`

selected=`printf "$languages\n$core_utils" | fzf`
read -p "query: " query

if printf $languages | grep -qs $selected; then
  tmux neww bash -c "curl -s cht.sh/$selected/`echo $query | tr ' ' '+'`; tmux copy-mode; while [ : ]; do sleep 1; done"
else
  tmux neww bash -c "curl -s cht.sh/$selected~$query; tmux copy-mode; while [ : ]; do sleep 1; done"
fi
